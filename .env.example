# Leave blank to use the built-in mock controller during UI development.
# In production this should point to the local WLED proxy/API, not directly to an internet-exposed ESP32.
VITE_WLED_API_BASE=

# Production server settings
PORT=3000

# Required to install updates from the Settings screen.
# Choose a private value and set the same variable in the systemd service environment.
UPDATE_KEY=change-this-to-a-private-key
