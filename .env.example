# Production lighting controller (server-side)
WLED_HOST=http://192.168.68.166

# OpenRGB runs on the gaming PC. Fill in the PC's reserved LAN address.
OPENRGB_HOST=192.168.68.179
OPENRGB_PORT=6742

# HTTP Hook plugin listener. Configure matching hooks in OpenRGB.
OPENRGB_HOOK_PROTOCOL=http
OPENRGB_HOOK_PORT=6743
OPENRGB_START_PATH=/gaming/start
OPENRGB_STOP_PATH=/gaming/stop
OPENRGB_AMBILIGHT_PATH=/gaming/ambilight
OPENRGB_AUDIO_PATH=/gaming/audio

# Frontend should use the same-origin WLED proxy when deployed through Express.
VITE_WLED_API_BASE=/api/wled

# Required only for the Settings > Software Update action.
UPDATE_KEY=jAQPLDtapa5LkUumaEvRPT2QsDDgszNywFcDGkrk3xZy1jyuYaT8sq3qukd
