[Unit]
Description=Gaming Lights web controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gaming-lights
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/etc/gaming-lights.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
